<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="space.holon.gpui">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Holon"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:debuggable="true">

        <!-- Soft-keyboard design: GpuiTextInputView hosts the platform IME and
             hops every view/IMM call onto the UI thread (JNI calls it from the
             android_main thread). GpuiNativeActivity exists solely to
             System.loadLibrary the native code so that view's native methods
             resolve — NativeActivity's own dlopen does not register them. -->
        <activity
            android:name="dev.gpui.mobile.GpuiNativeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">

            <meta-data
                android:name="android.app.lib_name"
                android:value="holon_gpui" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
