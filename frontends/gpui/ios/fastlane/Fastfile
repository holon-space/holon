default_platform(:ios)

# Auth is exclusively via an App Store Connect API key — no interactive
# Apple ID login, so this runs unattended in CI.
#
# The generated Holon.xcodeproj is simulator-only (CODE_SIGNING_ALLOWED=NO in
# project.yml, kept that way for frictionless local dev). The release build
# re-enables signing via xcargs overrides with MANUAL signing: CI imports the
# Distribution cert + provisioning profile into a throwaway keychain first
# (see .github/workflows/release-mobile.yml).
#
# Required env:
#   APPLE_TEAM_ID, APPLE_API_KEY_ID, APPLE_API_ISSUER_ID,
#   APPLE_API_KEY_P8_BASE64 (base64 of the .p8 key file),
#   IOS_PROVISIONING_PROFILE_NAME (set by the workflow from the installed profile),
#   HOLON_VERSION, HOLON_BUILD_NUMBER

platform :ios do
  desc "Build a signed Release IPA and upload it to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER_ID"),
      key_content: ENV.fetch("APPLE_API_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    set_info_plist_value(path: "Info.plist", key: "CFBundleShortVersionString",
                         value: ENV.fetch("HOLON_VERSION"))
    set_info_plist_value(path: "Info.plist", key: "CFBundleVersion",
                         value: ENV.fetch("HOLON_BUILD_NUMBER"))

    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")

    build_app(
      project: "Holon.xcodeproj",
      scheme: "Holon",
      configuration: "Release",
      output_directory: "build",
      output_name: "Holon.ipa",
      xcargs: [
        "CODE_SIGNING_ALLOWED=YES",
        "CODE_SIGNING_REQUIRED=YES",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
        "DEVELOPMENT_TEAM=#{team_id}",
        "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\""
      ].join(" "),
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "space.holon.gpui" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
