{
  "name": "concurrent_content_edit_merge",
  "description": "Axis 3 regression replay: a peer edits a block's content, the primary concurrently edits the same block (External org write), then MergeFromPeer runs the real Loro merge. The ref models the outcome via the loro_merge_text oracle (merge_peer_blocks_into_primary) -- divergence means the oracle mis-models production merge/tie-break semantics.",
  "environment": {
    "wiring": {
      "storage_adapters": [
        "Loro",
        "Org",
        "Markdown",
        "Turso"
      ],
      "sync_adapters": [
        "Todoist"
      ],
      "actors": [
        "MCPServer",
        "ActionEngine"
      ]
    },
    "env_flags": {}
  },
  "initial_state": null,
  "transitions": [
    {
      "WriteOrgFile": {
        "filename": "conflict_0.org",
        "blocks": [
          {
            "id": "block:conflict-a",
            "parent_id": "block:gen-placeholder",
            "content": "Alpha base",
            "content_type": "text",
            "source_language": null,
            "source_name": null,
            "properties": {
              "ID": "conflict-a"
            },
            "marks": null,
            "created_at": 1781118426785,
            "updated_at": 1781118426785
          },
          {
            "id": "block:conflict-b",
            "parent_id": "block:gen-placeholder",
            "content": "Beta base",
            "content_type": "text",
            "source_language": null,
            "source_name": null,
            "properties": {
              "ID": "conflict-b"
            },
            "marks": null,
            "created_at": 1781118426785,
            "updated_at": 1781118426785
          }
        ],
        "keyword_set": null
      }
    },
    {
      "StartApp": {
        "wait_for_ready": true,
        "enable_fake_mcp": true,
        "enable_loro": true
      }
    },
    {
      "AddPeer": null
    },
    {
      "PeerEdit": {
        "peer_idx": 0,
        "op": {
          "Update": {
            "stable_id": "conflict-a",
            "content": "peer edit"
          }
        }
      }
    },
    {
      "ApplyMutation": {
        "event": {
          "source": "External",
          "mutation": {
            "Update": {
              "entity": "block",
              "id": "block:conflict-a",
              "fields": {
                "content": "primary edit"
              }
            }
          }
        }
      }
    },
    {
      "MergeFromPeer": {
        "peer_idx": 0
      }
    }
  ]
}