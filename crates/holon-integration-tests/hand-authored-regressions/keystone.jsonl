# exactly the decoded 2026-07-31 payload (33 vs 31 blocks, both extras parented to block:ref-doc-2).
{"name": "undo-over-reverts-file-ingested-content-blocks", "description": "F2 org-blocks-ref-diverge (task #76): a USER-origin CreateBlockUnderFocus snapshots pre-file oracle state; a WriteOrgFile external write is INGEST-origin (not undoable in prod); UndoLastMutation restores the pre-file oracle snapshot, dropping the file's CONTENT blocks oracle-side while prod KEEPS them -> spurious-on-SUT in inv-blocks-match-ref/{org,block_raw,matview} with only_in_ref empty. Oracle-side undo over-reverts file-ingested content blocks; the doc-root-only fix left this half open.", "transitions": [{"CreateBlockUnderFocus": {"content": "g", "id": "block:gen-0"}}, {"WriteOrgFile": {"filename": "doc_2.org", "blocks": [{"id": "block:ext-a", "parent_id": "block:gen-placeholder", "content": "external alpha", "content_type": "text", "source_language": null, "source_name": null, "properties": {}, "marks": null, "collapsed": false, "created_at": 0, "updated_at": 0}, {"id": "block:ext-b", "parent_id": "block:gen-placeholder", "content": "external beta", "content_type": "text", "source_language": null, "source_name": null, "properties": {}, "marks": null, "collapsed": false, "created_at": 0, "updated_at": 0}], "keyword_set": null}}, {"UndoLastMutation": null}]}

